#: authentication/forms.py:31
#: authentication/templates/authentication/observe.html:25
msgid "Your email address"
msgstr "Votre adresse e-mail"

#: authentication/forms.py:54
msgid "Stay signed in on this device"
msgstr "Garder la connexion sur cet appareil"

#: authentication/models.py:71
msgid "Superuser must have is_staff=True."
msgstr "Un superutilisateur doit avoir is_staff=True."

#: authentication/models.py:73
msgid "Superuser must have is_superuser=True."
msgstr "Un superutilisateur doit avoir is_superuser=True."

#: authentication/provisional.py:148
msgid ""
"Your email address wasn't confirmed in time, so anything you recorded was "
"deleted."
msgstr ""
"Votre adresse e-mail n'a pas été confirmée à temps : ce que vous aviez "
"enregistré a donc été supprimé."

#: authentication/templates/authentication/email/magic_link.html:25
#: authentication/templates/authentication/email/magic_link.txt:22
msgid "Hello,"
msgstr "Bonjour,"

#: authentication/templates/authentication/email/magic_link.html:27
msgid ""
"You recorded an observation on Mobilito, but haven't confirmed your email "
"address yet. Confirm it's you so that what you recorded counts:"
msgstr ""
"Vous avez enregistré une observation sur Mobilito, mais vous n'avez pas "
"encore confirmé votre adresse e-mail. Confirmez que c'est bien vous pour que "
"votre observation soit prise en compte :"

#: authentication/templates/authentication/email/magic_link.html:29
msgid ""
"You gave this email address on Mobilito. Confirm it's you so that what you "
"record counts:"
msgstr ""
"Vous avez donné cette adresse e-mail sur Mobilito. Confirmez que c'est bien "
"vous pour que vos observations soient prises en compte :"

#: authentication/templates/authentication/email/magic_link.html:31
msgid "Use the button below to sign in to Mobilito:"
msgstr "Utilisez le bouton ci-dessous pour vous connecter à Mobilito :"

#: authentication/templates/authentication/email/magic_link.html:34
#: authentication/templates/authentication/verify.html:54
msgid "Confirm my email address"
msgstr "Confirmer mon adresse e-mail"

#: authentication/templates/authentication/email/magic_link.html:34
#: authentication/templates/authentication/start.html:25
#: authentication/templates/authentication/start.html:29
#: authentication/templates/authentication/verify.html:25
#: authentication/templates/authentication/verify.html:54
#: templates/includes/nav.html:64
msgid "Sign in"
msgstr "Se connecter"

#: authentication/templates/authentication/email/magic_link.html:38
#: authentication/templates/authentication/email/magic_link.txt:28
#, python-format
msgid ""
"If you don't confirm your email address by %(date)s, what you recorded will "
"be deleted."
msgstr ""
"Si vous ne confirmez pas votre adresse e-mail d'ici le %(date)s, ce que vous "
"avez enregistré sera supprimé."

#: authentication/templates/authentication/email/magic_link.html:43
#: authentication/templates/authentication/email/magic_link.txt:32
msgid "No hurry: you can finish what you're doing first."
msgstr "Rien ne presse : vous pouvez d'abord terminer ce que vous faites."

#: authentication/templates/authentication/email/magic_link.html:45
#: authentication/templates/authentication/email/magic_link.txt:34
msgid "You'll be taken back to what you were doing."
msgstr "Vous reviendrez là où vous en étiez."

#: authentication/templates/authentication/email/magic_link.html:49
#: authentication/templates/authentication/email/magic_link.txt:36
#, python-format
msgid "The link works once, for %(days)s day."
msgid_plural "The link works once, for %(days)s days."
msgstr[0] "Le lien ne fonctionne qu'une fois, pendant %(days)s jour."
msgstr[1] "Le lien ne fonctionne qu'une fois, pendant %(days)s jours."

#: authentication/templates/authentication/email/magic_link.html:55
#: authentication/templates/authentication/email/magic_link.txt:40
#: authentication/templates/authentication/sent.html:42
#, python-format
msgid "The link works once, for %(minutes)s minute."
msgid_plural "The link works once, for %(minutes)s minutes."
msgstr[0] "Le lien ne fonctionne qu'une fois, pendant %(minutes)s minute."
msgstr[1] "Le lien ne fonctionne qu'une fois, pendant %(minutes)s minutes."

#: authentication/templates/authentication/email/magic_link.html:63
msgid "If the button doesn't work, copy this address into your browser:"
msgstr ""
"Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :"

#: authentication/templates/authentication/email/magic_link.html:68
#: authentication/templates/authentication/email/magic_link.txt:46
msgid ""
"If you didn't ask for this, you can ignore this email: nothing will be kept."
msgstr ""
"Si vous n'avez rien demandé, vous pouvez ignorer cet e-mail : rien ne sera "
"conservé."

#: authentication/templates/authentication/email/magic_link.html:70
#: authentication/templates/authentication/email/magic_link.txt:46
msgid "If you didn't ask for this, you can ignore this email."
msgstr "Si vous n'avez rien demandé, vous pouvez ignorer cet e-mail."

#: authentication/templates/authentication/email/magic_link.txt:24
msgid ""
"You recorded an observation on Mobilito, but haven't confirmed your email "
"address yet. Open this link to confirm it's you, so that what you recorded "
"counts:"
msgstr ""
"Vous avez enregistré une observation sur Mobilito, mais vous n'avez pas "
"encore confirmé votre adresse e-mail. Ouvrez ce lien pour confirmer que "
"c'est bien vous, afin que votre observation soit prise en compte :"

#: authentication/templates/authentication/email/magic_link.txt:24
msgid ""
"You gave this email address on Mobilito. Open this link to confirm it's you, "
"so that what you record counts:"
msgstr ""
"Vous avez donné cette adresse e-mail sur Mobilito. Ouvrez ce lien pour "
"confirmer que c'est bien vous, afin que vos observations soient prises en "
"compte :"

#: authentication/templates/authentication/email/magic_link.txt:24
msgid "Open this link to sign in to Mobilito:"
msgstr "Ouvrez ce lien pour vous connecter à Mobilito :"

#: authentication/templates/authentication/email/magic_link_subject.txt:22
msgid "Reminder: confirm your email address for Mobilito"
msgstr "Rappel : confirmez votre adresse e-mail pour Mobilito"

#: authentication/templates/authentication/email/magic_link_subject.txt:22
msgid "Confirm your email address for Mobilito"
msgstr "Confirmez votre adresse e-mail pour Mobilito"

#: authentication/templates/authentication/email/magic_link_subject.txt:22
msgid "Your Mobilito sign-in link"
msgstr "Votre lien de connexion à Mobilito"

#: authentication/templates/authentication/observe.html:30
msgid "Change your email address"
msgstr "Changer d'adresse e-mail"

#: authentication/templates/authentication/observe.html:32
msgid ""
"Correct your address and we'll send the link there instead. What you've "
"recorded so far is kept."
msgstr ""
"Corrigez votre adresse et nous y enverrons le lien. Ce que vous avez déjà "
"enregistré est conservé."

#: authentication/templates/authentication/observe.html:38
msgid "Before you start"
msgstr "Avant de commencer"

#: authentication/templates/authentication/observe.html:40
msgid ""
"What's your email address? You can start straight away. We'll email you a "
"link: open it within a week so that what you record counts."
msgstr ""
"Quelle est votre adresse e-mail ? Vous pouvez commencer tout de suite. Nous "
"vous enverrons un lien par e-mail : ouvrez-le dans la semaine pour que vos "
"observations soient prises en compte."

#: authentication/templates/authentication/observe.html:67
msgid "Continue"
msgstr "Continuer"

#: authentication/templates/authentication/observe.html:71
msgid ""
"We only use your address to send you this link and news about your "
"observations. It's never shown to anyone. If you don't confirm it within a "
"week, what you record is deleted."
msgstr ""
"Nous n'utilisons votre adresse que pour vous envoyer ce lien et des "
"nouvelles de vos observations. Elle n'est jamais montrée à personne. Si vous "
"ne la confirmez pas dans la semaine, ce que vous enregistrez est supprimé."

#: authentication/templates/authentication/observe.html:79
msgid "Already used Mobilito?"
msgstr "Vous avez déjà utilisé Mobilito ?"

#: authentication/templates/authentication/observe.html:80
msgid "Sign in instead"
msgstr "Me connecter plutôt"

#: authentication/templates/authentication/sent.html:25
#: authentication/templates/authentication/sent.html:30
msgid "Check your email"
msgstr "Consultez vos e-mails"

#: authentication/templates/authentication/sent.html:33
#, python-format
msgid "We've sent a sign-in link to <strong>%(email)s</strong>."
msgstr "Nous avons envoyé un lien de connexion à <strong>%(email)s</strong>."

#: authentication/templates/authentication/sent.html:36
msgid "Wrong address?"
msgstr "Mauvaise adresse ?"

#: authentication/templates/authentication/sent.html:39
msgid "We've sent you a sign-in link."
msgstr "Nous vous avons envoyé un lien de connexion."

#: authentication/templates/authentication/sent.html:49
msgid ""
"To sign in on this phone or computer, open the email here too. The link "
"signs in whichever device you open it on."
msgstr ""
"Pour vous connecter sur ce téléphone ou cet ordinateur, ouvrez l'e-mail ici "
"aussi. Le lien connecte l'appareil sur lequel vous l'ouvrez."

#: authentication/templates/authentication/sent.html:55
msgid "Nothing arrived after a few minutes? Check your spam folder."
msgstr ""
"Rien reçu après quelques minutes ? Regardez dans vos courriers indésirables."

#: authentication/templates/authentication/sent.html:58
msgid "Ask for a new link"
msgstr "Demander un nouveau lien"

#: authentication/templates/authentication/start.html:31
msgid ""
"Enter your email address and we'll send you a link. Tap it to sign in "
"&mdash; no password needed."
msgstr ""
"Saisissez votre adresse e-mail et nous vous enverrons un lien. Appuyez "
"dessus pour vous connecter &mdash; pas besoin de mot de passe."

#: authentication/templates/authentication/start.html:55
msgid "Send me a sign-in link"
msgstr "M'envoyer un lien de connexion"

#: authentication/templates/authentication/start.html:59
msgid ""
"We only use your address to sign you in and to tell you about your "
"observations. It's never shown to anyone."
msgstr ""
"Nous n'utilisons votre adresse que pour vous connecter et vous donner des "
"nouvelles de vos observations. Elle n'est jamais montrée à personne."

#: authentication/templates/authentication/verify.html:25
msgid "Confirm your email address"
msgstr "Confirmez votre adresse e-mail"

#: authentication/templates/authentication/verify.html:29
msgid "One more tap"
msgstr "Encore un geste"

#: authentication/templates/authentication/verify.html:32
#, python-format
msgid ""
"Tap the button to confirm <strong>%(email)s</strong>. What you recorded will "
"then count, and this device will be signed in."
msgstr ""
"Appuyez sur le bouton pour confirmer <strong>%(email)s</strong>. Ce que vous "
"avez enregistré sera alors pris en compte, et cet appareil sera connecté."

#: authentication/templates/authentication/verify.html:37
#, python-format
msgid "Tap the button to finish signing in as <strong>%(email)s</strong>."
msgstr ""
"Appuyez sur le bouton pour finir de vous connecter en tant que "
"<strong>%(email)s</strong>."

#: authentication/templates/authentication/verify.html:50
msgid "Uncheck this on a shared or public device."
msgstr "Décochez cette case sur un appareil partagé ou public."

#: authentication/templates/authentication/verify_invalid.html:25
#: authentication/templates/authentication/verify_invalid.html:30
msgid "Already confirmed"
msgstr "Déjà confirmée"

#: authentication/templates/authentication/verify_invalid.html:25
#: authentication/templates/authentication/verify_invalid.html:41
msgid "This link no longer works"
msgstr "Ce lien ne fonctionne plus"

#: authentication/templates/authentication/verify_invalid.html:32
msgid ""
"Your email address is already confirmed: what you recorded counts. To see it "
"on this device, sign in here too."
msgstr ""
"Votre adresse e-mail est déjà confirmée : ce que vous avez enregistré est "
"pris en compte. Pour le voir sur cet appareil, connectez-vous ici aussi."

#: authentication/templates/authentication/verify_invalid.html:38
msgid "Sign in on this device"
msgstr "Me connecter sur cet appareil"

#: authentication/templates/authentication/verify_invalid.html:43
msgid ""
"It has already been used, or it has expired. Ask for a new one and we'll "
"send it straight away."
msgstr ""
"Il a déjà servi, ou il a expiré. Demandez-en un nouveau et nous vous "
"l'enverrons tout de suite."

#: authentication/templates/authentication/verify_invalid.html:58
#: authentication/templates/authentication/verify_invalid.html:63
msgid "Send me a new link"
msgstr "M'envoyer un nouveau lien"

#: authentication/views.py:85
msgid ""
"There have been several requests for links in a short time. Check your inbox "
"and spam folder for one we've already sent. If it no longer works, you can "
"ask for a new one within the hour."
msgstr ""
"Plusieurs liens ont été demandés en peu de temps. Cherchez dans votre boîte "
"de réception et vos courriers indésirables celui que nous avons déjà envoyé. "
"S'il ne fonctionne plus, vous pourrez en demander un nouveau d'ici une heure."

#: authentication/views.py:142
msgid "We couldn't send the email just now. Please try again in a few minutes."
msgstr ""
"Nous n'avons pas pu envoyer l'e-mail pour le moment. Réessayez dans quelques "
"minutes."

#: authentication/views.py:238
msgid "Your email address is confirmed: what you recorded will count."
msgstr ""
"Votre adresse e-mail est confirmée : ce que vous avez enregistré sera pris "
"en compte."

#: authentication/views.py:243
msgid "Sign-in complete."
msgstr "Connexion réussie."

#: authentication/views.py:259
msgid "Your email address is already confirmed: what you recorded counts."
msgstr ""
"Votre adresse e-mail est déjà confirmée : ce que vous avez enregistré est "
"pris en compte."

#: authentication/views.py:304
msgid "You're already signed in."
msgstr "Connexion déjà active."

#: authentication/views.py:381
msgid ""
"You can start now, but we couldn't send the email just now. Use “Send it "
"again” in a few minutes."
msgstr ""
"Vous pouvez commencer, mais nous n'avons pas pu envoyer l'e-mail pour le "
"moment. Utilisez « Le renvoyer » dans quelques minutes."

#: authentication/views.py:391
#, python-format
msgid "We've sent a new link to %(email)s."
msgstr "Nous avons envoyé un nouveau lien à %(email)s."

#: authentication/views.py:393
#, python-format
msgid "You can start now. We've sent a link to %(email)s."
msgstr "Vous pouvez commencer. Nous avons envoyé un lien à %(email)s."

#: authentication/views.py:414
msgid ""
"We've sent several links already. Check your inbox and spam folder, or try "
"again later."
msgstr ""
"Nous avons déjà envoyé plusieurs liens. Regardez dans votre boîte de "
"réception et vos courriers indésirables, ou réessayez plus tard."

#: authentication/views.py:425
msgid "We couldn't send the email just now. Please try again soon."
msgstr ""
"Nous n'avons pas pu envoyer l'e-mail pour le moment. Réessayez bientôt."

#: authentication/views.py:430
#, python-format
msgid "We've sent the link again to %(email)s."
msgstr "Nous avons renvoyé le lien à %(email)s."

#: authentication/views.py:439
msgid "You're signed out."
msgstr "Déconnexion effectuée."

#: core/forms.py:44
msgid "Leave this field empty"
msgstr "Laissez ce champ vide"

#: core/geocoding.py:97
msgid "© OpenStreetMap contributors"
msgstr "© les contributeurs d’OpenStreetMap"

#: core/images.py:100
#, python-format
msgid "“%(name)s” isn't a photo we can read (JPEG or PNG work best)."
msgstr ""
"« %(name)s » n'est pas une photo que nous savons lire (JPEG ou PNG "
"conviennent le mieux)."

#: core/images.py:113
#, python-format
msgid "“%(name)s” is too large (at most %(mb)s MB per photo)."
msgstr "« %(name)s » est trop volumineuse (%(mb)s Mo au plus par photo)."

#: core/lifecycle.py:104 core/lifecycle.py:132
msgid "It hasn't been sent yet."
msgstr "Elle n'a pas encore été envoyée."

#: core/lifecycle.py:106
msgid "The count isn't finished."
msgstr "Le comptage n'est pas terminé."

#: core/lifecycle.py:109
msgid "Its author hasn't confirmed their email address yet."
msgstr ""
"La personne qui l'a publiée n'a pas encore confirmé son adresse e-mail."

#: core/lifecycle.py:124
msgid "Not a moderation outcome."
msgstr "Ce n'est pas une décision de modération."

#: core/maps.py:45
msgid ""
"&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> "
"contributors"
msgstr ""
"&copy; les contributeurs d’<a href=\"https://www.openstreetmap.org/"
"copyright\">OpenStreetMap</a>"

#: core/models.py:38
msgid "Draft"
msgstr "Brouillon"

#: core/models.py:39
msgid "Submitted"
msgstr "Envoyée"

#: core/models.py:40
msgid "Pending validation"
msgstr "En attente de validation"

#: core/models.py:41
msgid "Pending moderation"
msgstr "En attente de modération"

#: core/models.py:42 mobilito_app/admin.py:62
msgid "Published"
msgstr "Publiée"

#: core/models.py:43 mobilito_app/admin.py:68
msgid "Light hold"
msgstr "Retenue légère"

#: core/models.py:44 mobilito_app/admin.py:76
msgid "Sandboxed"
msgstr "Isolée"

#: core/models.py:56
msgid "Unreviewed"
msgstr "Non examinée"

#: core/models.py:57
msgid "Cleared"
msgstr "Validée"

#: core/models.py:58
msgid "Flagged for review"
msgstr "Alerte à examiner"

#: core/templates/core/credits.html:25 core/templates/core/credits.html:28
#: templates/includes/footer.html:31
msgid "Credits"
msgstr "Crédits"

#: core/templates/core/credits.html:30
msgid "Maps and addresses"
msgstr "Cartes et adresses"

#: core/templates/core/credits.html:32
msgid "Map:"
msgstr "Carte :"

#: core/templates/core/credits.html:33 templates/includes/footer.html:30
msgid "Addresses:"
msgstr "Adresses :"

#: core/templates/core/credits.html:36
msgid ""
"OpenStreetMap is a map of the world made by volunteers. Its data is "
"available under the <a href=\"https://opendatacommons.org/licenses/odbl/"
"\">Open Database License</a>."
msgstr ""
"OpenStreetMap est une carte du monde faite par des bénévoles. Ses données "
"sont disponibles sous la <a href=\"https://opendatacommons.org/licenses/odbl/"
"\">Licence ouverte de base de données</a> (ODbL)."

#: core/templates/core/credits.html:45
msgid ""
"Mobilito’s traffic counts grew out of a first prototype by Benjamin "
"Mourgues, whose field trials shaped the counting screen."
msgstr ""
"Les comptages de Mobilito sont nés d’un premier prototype de Benjamin "
"Mourgues, dont les essais sur le terrain ont façonné l’écran de comptage."

#: core/templates/core/credits.html:51
msgid ""
"Mobilito is free software: you may use, study, share and improve it under "
"the <a href=\"https://www.gnu.org/licenses/agpl-3.0.html\">GNU Affero "
"General Public License</a>, version 3 or later. © Français pour une "
"Meilleure Mobilité."
msgstr ""
"Mobilito est un logiciel libre : vous pouvez l’utiliser, l’étudier, le "
"partager et l’améliorer selon les termes de la <a href=\"https://www.gnu.org/"
"licenses/agpl-3.0.html\">Licence publique générale GNU Affero</a>, version 3 "
"ou ultérieure. © Français pour une Meilleure Mobilité."

#: core/templates/core/credits.html:57
msgid "Get the source code."
msgstr "Obtenir le code source."

#: core/templates/core/credits.html:60
msgid ""
"Built with <a href=\"https://www.djangoproject.com/\">Django</a>, <a "
"href=\"https://leafletjs.com/\">Leaflet</a>, <a href=\"https://"
"getbootstrap.com/\">Bootstrap</a>, <a href=\"https://icons.getbootstrap.com/"
"\">Bootstrap Icons</a> and <a href=\"https://htmx.org/\">htmx</a>."
msgstr ""
"Réalisé avec <a href=\"https://www.djangoproject.com/\">Django</a>, <a "
"href=\"https://leafletjs.com/\">Leaflet</a>, <a href=\"https://"
"getbootstrap.com/\">Bootstrap</a>, <a href=\"https://icons.getbootstrap.com/"
"\">Bootstrap Icons</a> et <a href=\"https://htmx.org/\">htmx</a>."

#: core/templates/core/includes/map_widget.html:45
msgid "Drag the map until the pink target is on the spot."
msgstr ""
"Faites glisser la carte jusqu'à ce que la cible rose soit sur l'endroit."

#: core/templates/core/includes/map_widget.html:50
msgid "Map. Use the arrow keys to move it."
msgstr "Carte. Utilisez les flèches du clavier pour la déplacer."

#: core/templates/core/includes/map_widget.html:53
msgid "The map couldn't load. Check your connection and reload the page."
msgstr ""
"La carte n'a pas pu se charger. Vérifiez votre connexion et rechargez la "
"page."

#: core/templates/core/includes/map_widget.html:77
#: core/templates/core/includes/map_widget.html:78
msgid "Go to my location"
msgstr "Aller à ma position"

#: core/templates/core/includes/map_widget.html:85
msgid "No observations here yet. Zoom out or move the map to look further."
msgstr ""
"Pas encore d'observation ici. Dézoomez ou déplacez la carte pour chercher "
"plus loin."

#: core/templates/core/includes/map_widget.html:86
msgid ""
"We couldn’t load the observations. Check your connection: moving the map "
"tries again."
msgstr ""
"Nous n'avons pas pu charger les observations. Vérifiez votre connexion, puis "
"déplacez la carte pour réessayer."

#: core/templates/core/includes/map_widget.html:100
msgid "Use device location"
msgstr "Utiliser la position de l'appareil"

#: core/templates/core/includes/map_widget.html:103
msgid "We'll remember this choice."
msgstr "Nous retiendrons ce choix."

#: core/templates/core/includes/map_widget.html:112
msgid ""
"Your observation will be marked “location not checked”, which makes it less "
"useful to local authorities."
msgstr ""
"Votre observation sera marquée « position non vérifiée », ce qui la rend "
"moins utile aux collectivités."

#: core/templates/core/includes/map_widget.html:113
msgid ""
"Your browser is blocking location. You can allow it in your browser "
"settings, or place the target by hand. Until then, your observation will be "
"marked “location not checked”."
msgstr ""
"Votre navigateur bloque la localisation. Vous pouvez l'autoriser dans ses "
"réglages, ou placer la cible à la main. En attendant, votre observation sera "
"marquée « position non vérifiée »."

#: core/templates/core/includes/map_widget.html:114
msgid ""
"This browser can’t share your position. Place the target by hand. Your "
"observation will be marked “location not checked”."
msgstr ""
"Ce navigateur ne peut pas partager votre position. Placez la cible à la "
"main. Votre observation sera marquée « position non vérifiée »."

#: core/templates/core/includes/map_widget.html:115
msgid ""
"We couldn’t get your position. Tap the arrow button at the top right of the "
"map to try again, or place the target by hand."
msgstr ""
"Nous n'avons pas pu obtenir votre position. Appuyez sur le bouton flèche en "
"haut à droite de la carte pour réessayer, ou placez la cible à la main."

#: core/templates/core/includes/map_widget.html:136
msgid "Confirm location"
msgstr "Confirmer l'emplacement"

#: core/templates/core/includes/map_widget.html:141
msgid "You moved the map. Tap “Confirm location” again."
msgstr ""
"Vous avez déplacé la carte. Appuyez à nouveau sur « Confirmer "
"l'emplacement »."

#: core/templates/core/includes/map_widget.html:142
msgid ""
"The map moved to where you are. Check the target and tap “Confirm location” "
"again."
msgstr ""
"La carte s'est placée là où vous êtes. Vérifiez la cible et appuyez à "
"nouveau sur « Confirmer l'emplacement »."

#: core/templates/core/includes/map_widget.html:143
msgid "We couldn’t confirm the location. Check your connection and try again."
msgstr ""
"Nous n'avons pas pu confirmer l'emplacement. Vérifiez votre connexion et "
"réessayez."

#: core/templates/core/includes/map_widget.html:149
msgid "Loading…"
msgstr "Chargement…"

#: core/templates/core/includes/map_widget.html:150
#: core/templates/core/includes/map_widget.html:157
msgid "Observation"
msgstr "Observation"

