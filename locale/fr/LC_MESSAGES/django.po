msgstr "Ce comptage n'a pas été terminé"

#: mobilito_app/templates/mobilito_app/counts/stale.html:36
#, python-format
msgid "Started %(date)s"
msgstr "Commencé le %(date)s"

#: mobilito_app/templates/mobilito_app/counts/stale.html:38
